---
import { url, companyLinks } from '../lib/site';
interface Props { contact?: boolean }
const { contact=true }=Astro.props;
---
{contact && <section class="contact-section" id="contact" aria-labelledby="contact-title"><div class="wrap">
<p class="eyebrow">ЗВ’ЯЗОК ІЗ ПІДПРИЄМСТВОМ</p><h2 id="contact-title">Почнемо з <mark>вашої задачі.</mark></h2>
<div class="contact-grid"><div class="contact-details">
<h3>Поговорімо про деталі</h3><p>Опишіть виріб, обладнання чи потрібну роботу. Креслення та фото можна додати до листа.</p>
<a class="contact-phone" href="tel:+380673775670">+38 (067) 377-56-70</a><a class="contact-email" href="mailto:tovdzs@gmail.com">tovdzs@gmail.com <span aria-hidden="true">↗</span></a>
<div class="hours"><span>ПОНЕДІЛОК — П’ЯТНИЦЯ</span><strong>09:00 — 18:00</strong><span>СУБОТА — НЕДІЛЯ</span><strong>Вихідні</strong></div>
<p class="address">Україна, м. Дніпро</p><a class="text-link" href={url('/contacts')}>Усі контакти ↗</a>
</div><form class="contact-form" action="mailto:tovdzs@gmail.com" method="get" data-contact-form>
<div class="form-pair"><label>Ваше ім’я <span aria-hidden="true">*</span><input name="name" autocomplete="name" required maxlength="100" placeholder="Як до вас звертатися"/></label><label>Телефон<input name="phone" type="tel" autocomplete="tel" maxlength="50" placeholder="+380"/></label></div>
<label>Електронна пошта <span aria-hidden="true">*</span><input name="email" type="email" autocomplete="email" required maxlength="200" placeholder="name@company.ua"/></label>
<label>Компанія<input name="company" autocomplete="organization" maxlength="200" placeholder="Назва підприємства"/></label>
<label>Що потрібно виготовити чи відновити? <span aria-hidden="true">*</span><textarea name="message" required rows="4" maxlength="5000" placeholder="Тип обладнання, деталь, характер робіт…"></textarea></label>
<p class="form-note">Кнопка підготує лист у вашій поштовій програмі. Ви зможете додати файли та надіслати його.</p>
<div class="form-actions"><p class="form-status" role="status" aria-live="polite"></p><button class="button" type="submit">Підготувати лист <span aria-hidden="true">↗</span></button></div>
</form></div></div></section>}
<footer class="site-footer"><div class="wrap footer-top"><a class="footer-brand" href={url('/')}>ДЗС<span>Точність. Досвід. Відповідальність.</span></a><nav aria-label="Про підприємство">{companyLinks.map(item=><a href={url(item.href)}>{item.title}</a>)}</nav><div><a href="mailto:tovdzs@gmail.com">tovdzs@gmail.com</a><a href="tel:+380673775670">+38 (067) 377-56-70</a><span>Дніпро, Україна</span></div></div><div class="wrap footer-bottom"><span>© {new Date().getFullYear()} ТОВ «Дніпропетровський завод спецремонта»</span><a href="#main">Нагору ↑</a></div></footer>
<script>
document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach(form=>{
  form.addEventListener('submit',event=>{
    event.preventDefault();
    if(!form.reportValidity())return;
    const data=new FormData(form);
    const body=['Ім’я: '+data.get('name'),'Компанія: '+(data.get('company')||'—'),'Телефон: '+(data.get('phone')||'—'),'Email: '+data.get('email'),'',String(data.get('message'))].join('\n');
    const query=new URLSearchParams({subject:'Запит до ДЗС',body});
    window.location.href='mailto:tovdzs@gmail.com?'+query.toString();
    const status=form.querySelector<HTMLElement>('.form-status');
    if(status)status.textContent='Надішліть підготовлений лист у своїй поштовій програмі. Або напишіть на tovdzs@gmail.com.';
  });
});
</script>
