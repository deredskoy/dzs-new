---
interface Props { locale?:Locale }
const {locale='uk'}=Astro.props;
const t=translator(locale);
import { translator, type Locale } from '../lib/i18n';
function gear(teeth: number, outer: number, root: number, hole: number) {
  const points = Array.from({ length: teeth * 4 }, (_, i) => {
    const r = i % 4 === 1 || i % 4 === 2 ? outer : root;
    const a = (i / (teeth * 4)) * Math.PI * 2;
    return (Math.cos(a) * r).toFixed(2) + ',' + (Math.sin(a) * r).toFixed(2);
  });
  return 'M' + points.join(' L') + 'Z M' + hole + ',0 A' + hole + ',' + hole + ' 0 1 0 ' + -hole + ',0 A' + hole + ',' + hole + ' 0 1 0 ' + hole + ',0 Z';
}
