---
import Layout from '../layouts/Layout.astro';
import GearDrawing from '../components/GearDrawing.astro';
import WorkSteps from '../components/WorkSteps.astro';
import ContentCards from '../components/ContentCards.astro';
import { url as siteUrl,paths,categories,pageFor } from '../lib/site';
import { translator, type Locale } from '../lib/i18n';
interface Props { locale?: Locale }
const { locale = 'uk' } = Astro.props;
const t = translator(locale);
const url = (path: string) => siteUrl(path, locale);
const featured=[
  {title:'Гальмівні накладки БеЛАЗ',image:'belaz.webp',href:paths.belaz,code:'75131-3577060-01'},
  {title:'Колодки HITACHI EH 3500',image:'hitachi.webp',href:paths.hitachi,code:'4674697'},
  {title:'Інші фрикційні вироби',image:'friction.webp',href:paths.friction,code:'ЗА ВАШИМ ЗАМОВЛЕННЯМ'},
];
const gallery=pageFor('/portfolio', locale)!.cards.slice(0,3);
---
<Layout locale={locale}>
<section class="hero-section wrap"><div class="hero-copy">
<p class="eyebrow"><span class="orange-dot"></span> {t("ДНІПРО · ПРАЦЮЄМО З 2003 РОКУ")}</p>
<h1>{t("ДЗС")}</h1><p class="hero-lead">{t("Виготовлення та ремонт")}<br/>{t("вузлів і агрегатів.")}</p>
<p class="hero-description">{t("Від окремої деталі до складного механізму. Власна виробнича база, досвідчені спеціалісти та увага до кожного замовлення.")}</p>
<div class="hero-actions"><a class="button" href="#contact">{t("Обговорити задачу")} <span aria-hidden="true">↗</span></a><a class="text-link" href={url('/catalog')}>{t("Наші можливості →")}</a></div>
</div><div class="hero-art"><GearDrawing locale={locale}/></div><div class="hero-baseline"><span>{t("ВИРОБНИЦТВО / РЕМОНТ / МЕХАНІЧНА ОБРОБКА")}</span><a href="#services" aria-label={t("Перейти до продукції")}>↓</a></div></section>

<section class="services-section" id="services"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">{t("ДЕТАЛІ ДЛЯ СКЛАДНИХ ЗАДАЧ")}</p><h2>{t("Наша продукція")}</h2></div><a class="text-link" href={url('/catalog')}>{t("Увесь каталог ↗")}</a></div>
<div class="featured-products">{featured.map(item=><a class="featured-product" href={url(item.href)}><div class="featured-image"><img src={url('/media/'+item.image)} width="640" height="480" alt={t(item.title)} loading="lazy" decoding="async"/></div><div class="featured-title"><h3>{t(item.title)}</h3><span aria-hidden="true">↗</span></div><span class="product-code">{t(item.code)}</span></a>)}</div>
<div class="capabilities">{categories.map(item=><a href={url(item.href)}><h3>{t(item.title)} <span aria-hidden="true">↗</span></h3><p>{t(item.detail)}</p></a>)}</div></div></section>

<section class="about-section wrap"><p class="eyebrow">{t("ПІДПРИЄМСТВО З ДОСВІДОМ")}</p><h2>{t("Розвиваємо виробництво.")}<br/><mark>{t("Тримаємо якість.")}</mark></h2><div class="about-grid">
<div class="about-intro"><p>{t("Дніпропетровський завод спецремонта працює з 2003 року. За цей час змінювались напрями роботи, але незмінними залишалися висока якість і відповідальність перед замовником.")}</p><a href={url('/states/o-predpriyatii')} class="text-link">{t("Більше про ДЗС ↗")}</a></div>
<div class="about-facts"><article><h3>{t("Власна база")}</h3><p>{t("Верстатний парк, кранове господарство та кваліфікована команда для повного циклу робіт.")}</p></article><article><h3>{t("Складні механізми")}</h3><p>{t("Планетарні редуктори, вузли спецтехніки та фрикційні вироби за індивідуальним замовленням.")}</p></article><article><h3>{t("Відповідальність")}</h3><p>{t("Погоджуємо умови, дотримуємося термінів і перевіряємо результат виконаних робіт.")}</p></article><article><h3>{t("Довіра на роки")}</h3><p>{t("Працюємо з підприємствами України та закордонними компаніями різних галузей промисловості.")}</p></article></div></div></section>

<section class="partners-strip"><div class="wrap"><p class="eyebrow">{t("НАШІ ЗАМОВНИКИ")}</p><div class="partner-names"><span>{t("МЕТІНВЕСТ")}</span><span>FERREXPO</span><span>{t("ДНІПРОМЛИН")}</span><span>{t("АДМІРАЛ")}</span><span>{t("СТАТОР")}</span></div></div></section>
<WorkSteps locale={locale}/>
<section class="gallery-section wrap"><div class="section-heading"><div><p class="eyebrow">{t("РЕЗУЛЬТАТ У ДЕТАЛЯХ")}</p><h2>{t("Наші роботи")}</h2></div><a class="text-link" href={url('/portfolio')}>{t("Уся галерея ↗")}</a></div><ContentCards cards={gallery} gallery locale={locale}/></section>
</Layout>
