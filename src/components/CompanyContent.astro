---
import CompanyLetter from './CompanyLetter.astro';
import { richHtml, type SourcePage } from '../lib/site';
import { machinePark, documents, photo } from '../lib/company';
import { translator, type Locale } from '../lib/i18n';
interface Props { page: SourcePage; locale: Locale }
const { page, locale } = Astro.props;
const t = translator(locale);
// Company pages use the full width: the text reads on the left, photos and key facts sit on the right.
const park = page.path === '/states/nash-stanochnyy-park' ? machinePark(page, locale) : undefined;
const docs = page.path === '/states/dokumenty' ? documents(page, locale) : undefined;
const gears = photo('https://dzs.in.ua/uploads/product/3abab2c4a26e211e57b9ea8982ba84ab.jpg');
// Small photos are enlarged by at most half, so they stay sharp.
const fit = (width: number) => `--max:${Math.round(width * 1.5)}px`;
---
{page.path === '/about-company' && <CompanyLetter locale={locale}/>}

{page.path === '/states/o-predpriyatii' && <section class="wrap company-layout">
  <aside class="company-aside" aria-label={t('Коротко про ДЗС')}>
    <figure class="company-photo"><img src={gears.src} width={gears.width} height={gears.height} alt={t('Планетарна передача: сонячна шестерня, сателіти й коронне колесо')} loading="lazy" decoding="async"/></figure>
    <dl class="facts-list">
      <div><dt>{t('Працюємо')}</dt><dd>{t('З 2003 року, Дніпро')}</dd></div>
      <div><dt>{t('Виробнича база')}</dt><dd>{t('Верстатний парк, кранове господарство, кваліфіковані робітники')}</dd></div>
      <div><dt>{t('Дозвіл на роботи підвищеної небезпеки')}</dt><dd>№ 080.11.12.29.52.3</dd></div>
    </dl>
  </aside>
  <div class="rich-content company-text" set:html={richHtml(page, locale)}/>
</section>}

{page.path === '/states/kollektiv-i-vakansii' && <section class="wrap company-layout">
  <aside class="company-aside company-vacancy" aria-labelledby="vacancy-title">
    <h2 id="vacancy-title">{t('Шукаємо токаря')}</h2>
    <dl class="facts-list">
      <div><dt>{t('Досвід')}</dt><dd>{t('Від 5 років')}</dd></div>
      <div><dt>{t('Повний день')}</dt><dd>{t('8:00–17:00, повний соцпакет, фіксований оклад')}</dd></div>
      <div><dt>{t('Вільний графік')}</dt><dd>{t('Узгоджується з керівництвом, відрядна оплата')}</dd></div>
    </dl>
    <a class="button" href="tel:+380673775670">+38 (067) 377-56-70</a>
  </aside>
  <div class="rich-content company-text" set:html={richHtml(page, locale)}/>
</section>}

{park && <section class="wrap machine-park">
  <p class="machine-intro">{park.intro}</p>
  <ul class="machine-index">{park.machines.map(machine => <li><a href={'#' + machine.id}>{machine.title}</a></li>)}</ul>
  {park.machines.map(machine => <article class="machine" id={machine.id} aria-labelledby={machine.id + '-title'}>
    <div class="machine-photos" data-count={machine.photos.length}>{machine.photos.map((photo, index) => <a class="machine-photo" href={photo.src} target="_blank" rel="noopener" data-shape={photo.shape} style={`--photo:url("${photo.src}");${fit(photo.width)}`}><img src={photo.src} width={photo.width} height={photo.height} alt={machine.photos.length > 1 ? machine.title + ', ' + t('фото') + ' ' + (index + 1) : machine.title} loading="lazy" decoding="async"/></a>)}</div>
    <div class="machine-text"><h2 id={machine.id + '-title'}>{machine.title}</h2><div class="rich-content" set:html={machine.html}/>{machine.service && <a class="text-link machine-service" href={machine.service.href}>{machine.service.title}</a>}</div>
  </article>)}
  <div class="rich-content machine-outro" set:html={park.outro}/>
</section>}

{docs && <section class="wrap documents" data-documents data-page-label={t('сторінка')}>
  <p class="documents-intro">{docs.intro}</p>
  <ol class="document-grid">{docs.items.map(item => <li><button type="button" class="document-card" aria-haspopup="dialog" data-title={item.title} data-pages={JSON.stringify(item.pages.map(({ src, width, height }) => ({ src, width, height })))}><span class="document-scan"><img src={item.cover.src} width={item.cover.width} height={item.cover.height} alt="" loading="lazy" decoding="async" draggable="false"/></span><span class="document-title">{item.title}{item.pages.length > 1 && <span class="document-pages-count">{item.pages.length} {t('стор.')}</span>}</span></button></li>)}</ol>
  <dialog class="document-viewer" aria-labelledby="document-viewer-title">
    <div class="document-viewer-bar"><h2 id="document-viewer-title"></h2><button type="button" class="document-viewer-close" data-close>{t('Закрити')} <span aria-hidden="true">×</span></button></div>
    <div class="document-viewer-pages"></div>
  </dialog>
</section>}

<script>
  // Documents open in a viewer instead of as files: the pages are watermarked images that
  // cannot be dragged, long-pressed or saved from the context menu.
  const section = document.querySelector<HTMLElement>('[data-documents]');
  const dialog = section?.querySelector('dialog');
  if (section && dialog) {
    const heading = dialog.querySelector('h2')!;
    const pages = dialog.querySelector('.document-viewer-pages')!;
    let opener: HTMLElement | undefined;
    section.addEventListener('contextmenu', event => {
      if ((event.target as Element).closest('.document-scan, .document-viewer-pages')) event.preventDefault();
    });
    section.addEventListener('dragstart', event => event.preventDefault());
    section.querySelectorAll<HTMLButtonElement>('.document-card').forEach(card => card.addEventListener('click', () => {
      opener = card;
      const list: { src: string; width: number; height: number }[] = JSON.parse(card.dataset.pages!);
      heading.textContent = card.dataset.title!;
      pages.replaceChildren(...list.map((page, index) => {
        const image = new Image(page.width, page.height);
        image.src = page.src;
        image.alt = list.length > 1 ? `${card.dataset.title}, ${section.dataset.pageLabel} ${index + 1}` : card.dataset.title!;
        image.draggable = false;
        return image;
      }));
      dialog.showModal();
      dialog.scrollTop = 0;
    }));
    dialog.addEventListener('click', event => {
      const target = event.target as Element;
      if (target === dialog || target.closest('[data-close]')) dialog.close();
    });
    dialog.addEventListener('close', () => { pages.replaceChildren(); opener?.focus(); });
  }
</script>
