---
import Layout from '../layouts/Layout.astro';
import GearDrawing from '../components/GearDrawing.astro';
import WorkSteps from '../components/WorkSteps.astro';
import ContentCards from '../components/ContentCards.astro';
import { url,paths,categories,pageFor } from '../lib/site';
const featured=[
  {title:'Гальмівні накладки БеЛАЗ',image:'belaz.webp',href:paths.belaz,code:'75131-3577060-01'},
  {title:'Колодки HITACHI EH 3500',image:'hitachi.webp',href:paths.hitachi,code:'4674697'},
  {title:'Інші фрикційні вироби',image:'friction.webp',href:paths.friction,code:'ЗА ВАШИМ ЗАМОВЛЕННЯМ'},
];
const gallery=pageFor('/portfolio')!.cards.slice(0,3);
---
<Layout>
<section class="hero-section wrap"><div class="hero-copy">
<p class="eyebrow"><span class="orange-dot"></span> ДНІПРО · ПРАЦЮЄМО З 2003 РОКУ</p>
<h1>ТОВ ДЗС</h1><p class="hero-lead">Виготовлення та ремонт<br/>вузлів і агрегатів.</p>
<p class="hero-description">Від окремої деталі до складного механізму. Власна виробнича база, досвідчені спеціалісти та увага до кожного замовлення.</p>
<div class="hero-actions"><a class="button" href="#contact">Обговорити задачу <span aria-hidden="true">↗</span></a><a class="text-link" href={url('/catalog')}>Наші можливості →</a></div>
</div><div class="hero-art"><GearDrawing/></div><div class="hero-baseline"><span>ВИРОБНИЦТВО / РЕМОНТ / МЕХАНІЧНА ОБРОБКА</span><a href="#services" aria-label="Перейти до продукції">↓</a></div></section>

<section class="services-section" id="services"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">ДЕТАЛІ ДЛЯ СКЛАДНИХ ЗАДАЧ</p><h2>Наша продукція</h2></div><a class="text-link" href={url('/catalog')}>Увесь каталог ↗</a></div>
<div class="featured-products">{featured.map((item,i)=><a class="featured-product" href={url(item.href)}><span class="product-index">0{i+1}</span><div class="featured-image"><img src={url('/media/'+item.image)} width="640" height="480" alt={item.title} loading="lazy" decoding="async"/></div><div class="featured-title"><h3>{item.title}</h3><span aria-hidden="true">↗</span></div><span class="product-code">{item.code}</span></a>)}</div>
<div class="capabilities">{categories.map(item=><a href={url(item.href)}><h3>{item.title} <span aria-hidden="true">↗</span></h3><p>{item.detail}</p></a>)}</div></div></section>

<section class="about-section wrap"><p class="eyebrow">ПІДПРИЄМСТВО З ДОСВІДОМ</p><h2>Розвиваємо виробництво.<br/><mark>Тримаємо якість.</mark></h2><div class="about-grid">
<div class="about-intro"><p>Дніпропетровський завод спецремонта працює з 2003 року. За цей час змінювались напрями роботи, але незмінними залишалися висока якість і відповідальність перед замовником.</p><a href={url('/states/o-predpriyatii')} class="text-link">Більше про ДЗС ↗</a></div>
<div class="about-facts"><article><span>01 / ВИРОБНИЦТВО</span><h3>Власна база</h3><p>Верстатний парк, кранове господарство та кваліфікована команда для повного циклу робіт.</p></article><article><span>02 / МОЖЛИВОСТІ</span><h3>Складні механізми</h3><p>Планетарні редуктори, вузли спецтехніки та фрикційні вироби за індивідуальним замовленням.</p></article><article><span>03 / ПІДХІД</span><h3>Відповідальність</h3><p>Погоджуємо умови, дотримуємося термінів і перевіряємо результат виконаних робіт.</p></article><article><span>04 / ПАРТНЕРСТВО</span><h3>Довіра на роки</h3><p>Працюємо з підприємствами України та закордонними компаніями різних галузей промисловості.</p></article></div></div></section>

<section class="partners-strip"><div class="wrap"><p class="eyebrow">НАШІ ЗАМОВНИКИ</p><div class="partner-names"><span>МЕТІНВЕСТ</span><span>FERREXPO</span><span>ДНІПРОМЛИН</span><span>АДМІРАЛ</span><span>СТАТОР</span></div></div></section>
<WorkSteps/>
<section class="gallery-section wrap"><div class="section-heading"><div><p class="eyebrow">РЕЗУЛЬТАТ У ДЕТАЛЯХ</p><h2>Наші роботи</h2></div><a class="text-link" href={url('/portfolio')}>Уся галерея ↗</a></div><ContentCards cards={gallery} gallery/></section>
</Layout>
