---
import Layout from '../layouts/Layout.astro';
import WorkSteps from '../components/WorkSteps.astro';
import ContentCards from '../components/ContentCards.astro';
import { sourcePages,aliases,pageFor,pageImages,titleFor,richHtml,imageUrl,url,categories,companyLinks,type SourcePage } from '../lib/site';
export function getStaticPaths() {
  return [...sourcePages.map(page=>({params:{path:page.path.slice(1)},props:{page}})),...Object.entries(aliases).map(([path,canonical])=>({params:{path:path.slice(1)},props:{page:pageFor(canonical)!}}))];
}
interface Props {page:SourcePage}
const {page}=Astro.props;
const title=titleFor(page);
const product=page.path.startsWith('/product/');
const catalog=page.path.startsWith('/catalog');
const gallery=page.path.startsWith('/portfolio');
const galleryAlbum=gallery&&page.path!='/portfolio';
const company=page.path.startsWith('/states/')||page.path==='/about-company';
const contacts=page.path==='/contacts';
const images=pageImages(page);
const description=page.text?page.text.slice(0,155).trim()+(page.text.length>155?'…':''):title;
const parentHref=product||catalog?'/catalog':gallery?'/portfolio':'/about-company';
const parentTitle=product||catalog?'Продукція та послуги':gallery?'Галерея':'Підприємство';
---
<Layout title={title} description={description} canonicalPath={page.path}>
<div class="wrap breadcrumbs"><a href={url('/')}>Головна</a><span>/</span>{page.path!==parentHref&&!contacts&&<><a href={url(parentHref)}>{parentTitle}</a><span>/</span></>}<span aria-current="page">{title}</span></div>
{product?<section class="product-hero"><div class="wrap product-hero-grid"><div class="product-hero-image">{images[0]&&<img src={imageUrl(images[0].src)} width="900" height="700" alt={title} fetchpriority="high"/>}</div><div><p class="eyebrow">ВИРОБНИЦТВО / РЕМОНТ · ДЗС</p><h1>{title}</h1><p class="product-intro">Власна виробнича база. Робота за кресленням, технічним завданням або зразком замовника.</p><div class="product-cta"><a class="button button-light" href="#contact">Обговорити замовлення ↗</a><a href="tel:+380673775670">+38 (067) 377-56-70</a></div></div></div></section>:<section class="page-heading wrap"><p class="eyebrow">{catalog?'НАШІ МОЖЛИВОСТІ':gallery?'РОБОТА В ДЕТАЛЯХ':contacts?'БУДЬМО НА ЗВ’ЯЗКУ':'ДНІПРОПЕТРОВСЬКИЙ ЗАВОД СПЕЦРЕМОНТА'}</p><h1>{title}</h1></section>}

{company&&<nav class="wrap section-nav" aria-label="Розділи підприємства">{companyLinks.map(item=><a href={url(item.href)} aria-current={page.path===item.href?'page':undefined}>{item.title}</a>)}</nav>}
{catalog&&<nav class="wrap section-nav" aria-label="Напрями діяльності"><a href={url('/catalog')} aria-current={page.path==='/catalog'?'page':undefined}>Усі напрями</a>{categories.map(item=><a href={url(item.href)} aria-current={page.path===item.href||page.path.startsWith(item.href+'/')?'page':undefined}>{item.title}</a>)}</nav>}

{contacts?<section class="wrap contact-cards"><article><span class="eyebrow">01 / ТЕЛЕФОН</span><h2>Поговорімо</h2><a href="tel:+380673775670">+38 (067) 377-56-70</a><a href="tel:+380679723706">+38 (067) 972-37-06</a><a href="tel:+380967700405">+38 (096) 770-04-05</a></article><article><span class="eyebrow">02 / ЕЛЕКТРОННА ПОШТА</span><h2>Напишіть нам</h2><a href="mailto:tovdzs@gmail.com">tovdzs@gmail.com ↗</a><p>Додайте до листа креслення, фотографії та опис задачі.</p></article><article><span class="eyebrow">03 / ПІДПРИЄМСТВО</span><h2>Дніпро, Україна</h2><p>ТОВ «Дніпропетровський завод спецремонта»</p><p>49038, м. Дніпро</p><p>Перед візитом узгодьте час і місце зустрічі телефоном.</p></article></section>:galleryAlbum?<section class="wrap album-grid" aria-label="Фотографії виконаної роботи">{images.map((image,index)=><a href={imageUrl(image.src)} target="_blank" rel="noopener" aria-label={'Відкрити фото '+(index+1)+': '+title}><img src={imageUrl(image.src)} alt={image.alt||title+': фото '+(index+1)} width="1000" height="750" loading={index>1?'lazy':'eager'}/><span>ФОТО {String(index+1).padStart(2,'0')} <span aria-hidden="true">↗</span></span></a>)}</section>:<>
{page.text&&<section class:list={['wrap body-section',{'product-body':product}]}>{product&&<h2>Докладніше <mark>про виріб і роботи</mark></h2>}<div class="rich-content" set:html={richHtml(page)}/></section>}
{page.cards.length>0&&<section class="wrap card-section"><ContentCards cards={page.cards} gallery={gallery}/></section>}
{catalog&&!page.cards.length&&<div class="wrap empty-catalog"><p>Актуальну наявність та умови уточнюйте у наших спеціалістів.</p><a class="button" href="#contact">Зв’язатися з ДЗС ↗</a></div>}
{product&&images.length>1&&<section class="wrap product-gallery"><h2>Деталі зблизька</h2><div class="album-grid">{images.slice(1).map(image=><a href={imageUrl(image.src)} target="_blank" rel="noopener"><img src={imageUrl(image.src)} alt={image.alt||title} width="900" height="700" loading="lazy"/></a>)}</div></section>}
</>}
{product&&<WorkSteps/>}
</Layout>
